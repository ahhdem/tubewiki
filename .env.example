# Copy to backend/.env (or export as env vars). All keys take the TUBEWIKI_ prefix.

# Offline stub mode (no GPU): deterministic embedder + template LLM.
# Leave unset/false to use host Ollama; the backend auto-falls-back to offline if the
# box is unreachable at startup.
# TUBEWIKI_OFFLINE=1

# Host Ollama (GPU box). LLM uses /v1; embeddings use native /api/embed.
# Default = dual-GPU box (.78). The single-5090 box is http://192.168.86.11:11434.
TUBEWIKI_OLLAMA_BASE_URL=http://192.168.86.78:11434
TUBEWIKI_LLM_MODEL=registry.hackbarn.org/hf-co-unsloth/qwen3-30b-a3b-gguf:Q6_K
TUBEWIKI_EMBEDDING_MODEL=nomic-embed-text
TUBEWIKI_EMBEDDING_DIM=768

# Storage (defaults are repo-relative data/ and vault/, both gitignored)
# TUBEWIKI_VAULT_DIR=/path/to/vault
# TUBEWIKI_QDRANT_PATH=/path/to/qdrant

# API
TUBEWIKI_HOST=0.0.0.0
TUBEWIKI_PORT=8000
